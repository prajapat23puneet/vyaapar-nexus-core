SELECT t.id, t.category_id, c.name, t.sku, t.name, t.description, t.brand, t.unit_price, t.stock_quantity, t.reorder_level, t.image_url, t.is_active, t.weight_grams, t.tags IS NOT NULL, c.id, t0.value, t0.ordinality, t.created_at, t.updated_at&#xD;
FROM (&#xD;
    SELECT p.id, p.brand, p.category_id, p.created_at, p.description, p.image_url, p.is_active, p.name, p.reorder_level, p.sku, p.stock_quantity, p.tags, p.unit_price, p.updated_at, p.weight_grams&#xD;
    FROM products AS p&#xD;
    WHERE p.is_active&#xD;
    ORDER BY p.name&#xD;
    LIMIT @__p_1 OFFSET @__p_0&#xD;
) AS t&#xD;
INNER JOIN categories AS c ON t.category_id = c.id&#xD;
LEFT JOIN LATERAL unnest(t.tags) WITH ORDINALITY AS t0(value) ON TRUE&#xD;
ORDER BY t.name, t.id, c.id&#xD;
